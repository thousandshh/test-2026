       best_dd = 0
       best_start = -1
       best_end = -1

       for i in range(start + 1, end + 1):
           dd = values[i] / peak - 1

           if dd < best_dd:
               best_dd = dd
               best_start = peak_idx
               best_end = i

           if values[i] > peak:
               peak = values[i]
               peak_idx = i

       return best_dd, best_start, best_end

   drawdowns = []

   def search(start, end):
       dd, peak_idx, trough_idx = find_max_drawdown(
           start, end
       )

       if peak_idx == -1:
           return

       drawdowns.append(dd)

       # Search before the largest drawdown
       search(start, peak_idx)

       # Search after the largest drawdown
       search(trough_idx, end)

   search(0, len(rets))

   drawdowns.sort()

   if n > len(drawdowns):
