class Solution:
   def exist(self, board: List[List[str]], word: str) -> bool:
       def dfs(i, j, k):
           nonlocal board
           if k == len(word):
               return True
           if i >= 0 and i < len(board) and j >= 0 and j < len(board[0]):
               if board[i][j] == word[k]:
                   board[i][j] = '*'
                   left = dfs(i, j - 1, k + 1)
                   right = dfs(i, j + 1, k + 1)
                   up = dfs(i - 1, j, k + 1)
                   down = dfs(i + 1, j, k + 1)
                   board[i][j] = word[k]
                   if left or right or up or down:
                       return True
           return False
       for i in range(len(board)):
           for j in range(len(board[0])):
               if dfs(i, j, 0):
                   return True
       return False

