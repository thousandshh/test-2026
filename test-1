def findKthNextGreaterElement(prices, k):
    n = len(prices)
    ans = [-1] * n
    stacks = [[] for _ in range(k)]

    for i, p in enumerate(prices):
        for j in range(k - 1, -1, -1):
            while stacks[j] and prices[stacks[j][-1]] < p:
                idx = stacks[j].pop()

                if j == k - 1:
                    ans[idx] = i + 1
                else:
                    stacks[j + 1].append(idx)

        stacks[0].append(i)

    return ans

