class Solution:
   def findMedianSortedArrays(self, nums1: List[int], nums2: List[int]) -> float:
       def helper(n, left1, right1, left2, right2):
           if left1 >= right1:
               return nums2[left2 + n]
           if left2 >= right2:
               return nums1[left1 + n]
           if n == 0:
               return min(nums1[left1], nums2[left2])
           else:
               mid1 = (left1 + right1) // 2
               mid2 = (left2 + right2) // 2
               if mid1 - left1 + mid2 - left2 >= n:
                   if nums1[mid1] < nums2[mid2]:
                       return helper(n, left1, right1, left2, mid2)
                   else:
                       return helper(n, left1, mid1, left2, right2)
               else:
                   if nums1[mid1] < nums2[mid2]:
                       n_next = n - mid1 + left1 - 1
                       return helper(n_next, mid1 + 1, right1, left2, right2)
                   else:
                       n_next = n - mid2 + left2 - 1
                       return helper(n_next, left1, right1, mid2 + 1, right2)
       mid = (len(nums1) + len(nums2)) // 2
       midvalue1 = helper(mid - 1, 0, len(nums1), 0, len(nums2))
       midvalue2 = helper(mid, 0, len(nums1), 0, len(nums2))
       if (len(nums1) + len(nums2)) % 2:
           return midvalue2
       return (midvalue1 + midvalue2) / 2
